{
  "name": "remote-pc-agent",
  "version": "1.2.1",
  "description": "Remote PC Host and Windows agent for Remote PC Controller: pairs the PC with Supabase and serves remote-desktop sessions (screen, sound, input, clipboard, files, Remote Support).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js run",
    "desktop": "electron desktop/main.cjs",
    "pair": "node src/index.js pair",
    "status": "node src/index.js status",
    "test": "node test/protocol-test.js",
    "test:gates": "node test/session-gates-test.js",
    "pin": "node src/index.js pin",
    "support": "node src/index.js support",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "clipboardy": "^4.0.0",
    "jpeg-js": "^0.4.4",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@nut-tree/nut-js": "^4.0.0",
    "@roamhq/wrtc": "^0.10.0",
    "werift": "^0.20.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "author": "Remote PC Controller",
  "build": {
    "appId": "com.remotepc.host",
    "productName": "Remote PC Host",
    "copyright": "Remote PC Controller",
    "asar": false,
    "npmRebuild": false,
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "src/**",
      "package.json",
      "node_modules/**",
      "!config.json",
      "!screenshots/**",
      "!data/**",
      "!test/**",
      "!dist/**",
      "!*.log"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Remote PC Host",
      "artifactName": "Remote-PC-Host-Setup-${version}.${ext}",
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "Remote-PC-Host-${version}-portable.${ext}"
    }
  }
}
